---
import { Image } from 'astro:assets';
import skull from '../assets/skull.png';
import logo from '../assets/logo.svg';
---

<main class="booth-page">
	<section class="booth-kiosk" aria-label="Day of the Dead photo booth">
		<aside class="festival-rail" aria-label="Calavera Cabina">
			<button class="rail-mark" type="button" aria-label="Start over">
				<Image src={logo} alt="Calavera Cabina" />
			</button>
			<div class="rail-title">
				<h1>DAY OF THE DEAD</h1>
				<span aria-hidden="true"></span>
				<p>CALAVERA CABINA · 2026</p>
			</div>
			<span class="rail-flower" aria-hidden="true">✿</span>
		</aside>

		<div class="booth-stage">
			<header class="stage-header">
				<div>
					<p class="stage-kicker">CALAVERA CABINA · 2026</p>
					<h2 id="stage-title">Meet your other face</h2>
				</div>
				<ol class="progress-steps" aria-label="Progress">
					<li class="active" data-progress="1" aria-current="step"><span>1</span><small>Photo</small></li>
					<li data-progress="2"><span>2</span><small>Style</small></li>
					<li data-progress="3"><span>3</span><small>Reveal</small></li>
				</ol>
			</header>

			<div class="booth-window">
				<section class="capture-state" data-screen="capture" aria-labelledby="capture-title">
					<div class="portrait-guide">
						<span aria-hidden="true">✦</span>
						<span class="portrait-rings" aria-hidden="true"></span>
						<Image src={skull} alt="Colorful sugar skull portrait illustration" />
						<span aria-hidden="true">✦</span>
					</div>
					<h3 class="capture-title" id="capture-title">Ready for your close-up?</h3>
					<div class="capture-actions">
						<button class="button button-primary" type="button" data-action="open-camera">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l1.5-2h7L17 7h3v12H4z"/><circle cx="12" cy="13" r="4"/></svg>
							Take a selfie
						</button>						
					</div>
					<input class="visually-hidden" type="file" accept="image/*" data-file-input aria-label="Choose a photo" />
				</section>

				<section class="camera-state" data-screen="camera" aria-label="Camera capture" hidden>
					<video data-video autoplay playsinline muted></video>
					<div class="face-guide" aria-hidden="true"></div>
					<button class="shutter" type="button" data-action="capture" aria-label="Take photo"><span></span></button>
					<button class="camera-close" type="button" data-action="close-camera" aria-label="Close camera">×</button>
				</section>

				<section class="photo-state" data-screen="photo" aria-labelledby="photo-title" hidden>
					<div class="photo-preview-frame"><img data-photo-preview alt="Your selected portrait" /></div>
					<div class="photo-copy">
						<p class="stage-kicker">LOOKING GOOD</p>
						<h3 id="photo-title">That’s the one.</h3>
						<p>Your portrait stays yours. It’s only sent to create this keepsake.</p>
						<div class="photo-actions">
							<button class="button button-outline" type="button" data-action="retake">Choose another</button>
							<button class="button button-primary" type="button" data-action="continue">Pick a style <span aria-hidden="true">→</span></button>
						</div>
					</div>
				</section>

				<section class="style-state" data-screen="style" aria-labelledby="style-title" hidden>
					<div class="selfie-preview"><img data-style-preview alt="Portrait preview" /></div>
					<div class="style-controls">
						<p class="stage-kicker">STEP TWO · MAKE IT YOURS</p>
						<h3 id="style-title">Pick one tattoo style</h3>
						<p class="style-instruction">Choose your look</p>
						<div class="style-grid" role="group" aria-label="Portrait styles">
							<button class="style-ticket selected" type="button" data-style="catrina" aria-pressed="true">
								<span class="style-glyph" aria-hidden="true">✿</span><span><b>La Catrina</b><small>Flowers &amp; lace</small></span><span class="check" aria-hidden="true">✓</span>
							</button>
							<button class="style-ticket" type="button" data-style="catrin" aria-pressed="false">
								<span class="style-glyph" aria-hidden="true">♠</span><span><b>El Catrín</b><small>Elegant charro</small></span><span class="check" aria-hidden="true">✓</span>
							</button>
							<button class="style-ticket" type="button" data-style="golden" aria-pressed="false">
								<span class="style-glyph" aria-hidden="true">❉</span><span><b>Golden Flower</b><small>Marigold crown</small></span><span class="check" aria-hidden="true">✓</span>
							</button>
							<button class="style-ticket" type="button" data-style="night" aria-pressed="false">
								<span class="style-glyph" aria-hidden="true">☾</span><span><b>Night Spirit</b><small>Candles &amp; stars</small></span><span class="check" aria-hidden="true">✓</span>
							</button>
						</div>
						<button class="button button-primary create-button" type="button" data-action="create">Create my portrait <span aria-hidden="true">✦</span></button>
						<button class="text-button" type="button" data-action="back-photo">← Back to photo</button>
					</div>
				</section>

				<section class="result-state" data-screen="result" aria-labelledby="result-title" hidden>
					<img class="result-image" data-result-image alt="Your generated Día de Muertos portrait" />
					<div class="developing" data-developing>
						<div class="spinner" aria-hidden="true"></div>
						<b id="result-title">A little magic, coming right up.</b>
						<small data-result-copy>Adding marigolds and a touch of gold...</small>
					</div>
					<div class="result-toolbar" data-result-toolbar hidden>
						<div><p class="stage-kicker">YOUR CALAVERA PORTRAIT</p><h3>Made to remember.</h3></div>
						<div class="result-actions">
							<a class="icon-button" data-download href="#" download="calavera-portrait.jpg" aria-label="Download portrait" title="Download portrait"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 17v4h14v-4"/></svg></a>
							<button class="icon-button" type="button" data-action="print" aria-label="Print portrait" title="Print portrait"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M7 17H4V9h16v8h-3M7 14h10v7H7z"/><path d="M17 12h.01"/></svg></button>
							<button class="icon-button" type="button" data-action="start-over" aria-label="Start over" title="Start over"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6L4 8.8M4 4v5h5"/></svg></button>
						</div>
					</div>
				</section>

				<p class="error-note" data-error role="alert" hidden></p>
			</div>

			<footer class="stage-footer"><span aria-hidden="true">✦</span><p>Your photo is only used to create this portrait. It is not saved here.</p><span aria-hidden="true">✦</span></footer>
		</div>
	</section>
</main>

<script>
	type StyleKey = 'catrina' | 'catrin' | 'golden' | 'night';
	type ScreenKey = 'capture' | 'camera' | 'photo' | 'style' | 'result';

	const screens = [...document.querySelectorAll<HTMLElement>('[data-screen]')];
	const progress = [...document.querySelectorAll<HTMLElement>('[data-progress]')];
	const input = document.querySelector<HTMLInputElement>('[data-file-input]');
	const video = document.querySelector<HTMLVideoElement>('[data-video]');
	const errorNote = document.querySelector<HTMLElement>('[data-error]');
	const photoPreview = document.querySelector<HTMLImageElement>('[data-photo-preview]');
	const stylePreview = document.querySelector<HTMLImageElement>('[data-style-preview]');
	const resultImage = document.querySelector<HTMLImageElement>('[data-result-image]');
	const developing = document.querySelector<HTMLElement>('[data-developing]');
	const resultToolbar = document.querySelector<HTMLElement>('[data-result-toolbar]');
	const resultCopy = document.querySelector<HTMLElement>('[data-result-copy]');
	const downloadLink = document.querySelector<HTMLAnchorElement>('[data-download]');
	const title = document.querySelector<HTMLElement>('#stage-title');
	const fileReaderSupported = typeof File !== 'undefined';

	const stylePrompts: Record<StyleKey, { name: string; prompt: string; note: string }> = {
		catrina: { name: 'La Catrina', prompt: 'La Catrina-inspired Día de Muertos tattoo portrait, ornate flowers and delicate black lace framing the person, sugar-skull details, classic tattoo flash linework, preserve the person identity, facial features, age, and expression', note: 'Drawing flowers and lace...' },
		catrin: { name: 'El Catrín', prompt: 'El Catrín-inspired Día de Muertos tattoo portrait, elegant charro suit, embroidered sombrero and refined sugar-skull details, classic tattoo flash linework, preserve the person identity, facial features, age, and expression', note: 'Preparing an elegant charro portrait...' },
		golden: { name: 'Golden Flower', prompt: 'Día de Muertos tattoo portrait crowned with golden marigolds, warm amber petals and bold ornamental tattoo flash linework, preserve the person identity, facial features, age, and expression', note: 'Building a marigold crown...' },
		night: { name: 'Night Spirit', prompt: 'Día de Muertos tattoo portrait surrounded by glowing candles and stars, deep midnight tones, luminous sugar-skull details and fine tattoo flash linework, preserve the person identity, facial features, age, and expression', note: 'Lighting candles and stars...' },
	};
	let activeStyle: StyleKey = 'catrina';
	let sourceFile: File | null = null;
	let localPhotoUrl = '';
	let cameraStream: MediaStream | null = null;

	function showError(message = '') {
		if (!errorNote) return;
		errorNote.textContent = message;
		errorNote.hidden = !message;
	}

	function setScreen(screen: ScreenKey) {
		for (const panel of screens) panel.hidden = panel.dataset.screen !== screen;
		const step = screen === 'style' ? 2 : screen === 'result' ? 3 : 1;
		for (const item of progress) {
			const active = Number(item.dataset.progress) === step;
			item.classList.toggle('active', active);
			if (active) item.setAttribute('aria-current', 'step');
			else item.removeAttribute('aria-current');
		}
		if (title) title.textContent = screen === 'style' ? 'Pick one tattoo style' : screen === 'result' ? 'Your portrait is ready' : screen === 'photo' ? 'One last look' : 'Meet your other face';
		showError();
	}

	function releaseCamera() {
		cameraStream?.getTracks().forEach((track) => track.stop());
		cameraStream = null;
		if (video) video.srcObject = null;
	}

	function setPhoto(file: File) {
		if (!fileReaderSupported || !file.type.startsWith('image/')) {
			showError('Choose an image file to continue.');
			return;
		}
		if (file.size > 12 * 1024 * 1024) {
			showError('That image is over 12 MB. Choose a smaller photo.');
			return;
		}
		releaseCamera();
		if (localPhotoUrl) URL.revokeObjectURL(localPhotoUrl);
		sourceFile = file;
		localPhotoUrl = URL.createObjectURL(file);
		if (photoPreview) photoPreview.src = localPhotoUrl;
		if (stylePreview) stylePreview.src = localPhotoUrl;
		setScreen('photo');
	}

	async function openCamera() {
		showError();
		if (!navigator.mediaDevices?.getUserMedia) {
			showError('Camera access is not available in this browser.');
			return;
		}
		try {
			cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
			if (video) video.srcObject = cameraStream;
			setScreen('camera');
		} catch {
			showError('Camera access was blocked.');
		}
	}

	function capturePhoto() {
		if (!video || !video.videoWidth || !video.videoHeight) return;
		const canvas = document.createElement('canvas');
		canvas.width = video.videoWidth;
		canvas.height = video.videoHeight;
		const context = canvas.getContext('2d');
		if (!context) return;
		context.translate(canvas.width, 0);
		context.scale(-1, 1);
		context.drawImage(video, 0, 0, canvas.width, canvas.height);
		canvas.toBlob((blob) => {
			if (blob) setPhoto(new File([blob], 'calavera-selfie.jpg', { type: 'image/jpeg' }));
		}, 'image/jpeg', 0.92);
	}

	async function createPortrait() {
		if (!sourceFile || !resultImage || !developing || !resultToolbar || !resultCopy || !downloadLink) return;
		setScreen('result');
		resultImage.hidden = true;
		resultImage.classList.remove('is-final');
		developing.hidden = false;
		resultToolbar.hidden = true;
		resultCopy.textContent = stylePrompts[activeStyle].note;
		try {
			const form = new FormData();
			form.append('photo', sourceFile);
			form.append('style', activeStyle);
			const response = await fetch('/api/generate', { method: 'POST', body: form });
			const payload = await response.json() as { secureUrl?: string; error?: string };
			if (!response.ok || !payload.secureUrl) throw new Error(payload.error ?? 'Cloudinary could not create this portrait. Please try again.');
			resultImage.onload = () => {
				resultImage.hidden = false;
				requestAnimationFrame(() => resultImage.classList.add('is-final'));
				developing.hidden = true;
				resultToolbar.hidden = false;
				downloadLink.href = payload.secureUrl!;
			};
			resultImage.onerror = () => {
				resultImage.onerror = null;
				resultImage.onload = null;
				setScreen('style');
				showError('Cloudinary generated the portrait, but it could not be loaded. Please create it again.');
			};
			resultImage.src = payload.secureUrl;
		} catch (error) {
			setScreen('style');
			showError(error instanceof Error ? error.message : 'Something went wrong while creating your portrait. Please try again.');
		}
	}

	function resetBooth() {
		releaseCamera();
		if (localPhotoUrl) URL.revokeObjectURL(localPhotoUrl);
		localPhotoUrl = '';
		sourceFile = null;
		if (input) input.value = '';
		if (resultImage) resultImage.removeAttribute('src');
		setScreen('capture');
	}

	document.querySelectorAll<HTMLElement>('[data-action]').forEach((control) => {
		control.addEventListener('click', () => {
			switch (control.dataset.action) {
				case 'open-camera': void openCamera(); break;
				case 'close-camera': releaseCamera(); setScreen('capture'); break;
				case 'choose-file': input?.click(); break;
				case 'capture': capturePhoto(); break;
				case 'continue': setScreen('style'); break;
				case 'retake': setScreen('capture'); break;
				case 'back-photo': setScreen('photo'); break;
				case 'create': void createPortrait(); break;
				case 'print': window.print(); break;
				case 'start-over': resetBooth(); break;
			}
		});
	});

	input?.addEventListener('change', () => {
		const file = input.files?.[0];
		if (file) setPhoto(file);
	});

	document.querySelectorAll<HTMLButtonElement>('[data-style]').forEach((button) => {
		button.addEventListener('click', () => {
			activeStyle = button.dataset.style as StyleKey;
			for (const option of document.querySelectorAll<HTMLButtonElement>('[data-style]')) {
				const selected = option === button;
				option.classList.toggle('selected', selected);
				option.setAttribute('aria-pressed', String(selected));
			}
		});
	});

	document.querySelector('.rail-mark')?.addEventListener('click', resetBooth);
	window.addEventListener('pagehide', releaseCamera);
</script>

<style>
	:global(*) { box-sizing: border-box; }
	:global(:root) {
		--radius: .5rem;
		--background: oklch(.1914 .0114 60.71);
		--foreground: oklch(.9128 .047 77.63);
		--card: oklch(.235 .014 60.71);
		--primary: oklch(.7632 .1541 79.79);
		--primary-foreground: oklch(.1914 .0114 60.71);
		--pink: oklch(.5588 .1935 5.82);
		--muted: oklch(.29 .018 60.71);
		--muted-foreground: oklch(.73 .04 77.63);
		--border: oklch(.43 .03 70);
		--destructive: oklch(.7 .19 24);
		--font-display: 'Archivo Black', sans-serif;
		--font-sans: 'Hind', sans-serif;
	}
	:global(body) { background: var(--background); color: var(--foreground); font-family: var(--font-sans); letter-spacing: 0; }
	button, a { font: inherit; }
	button { cursor: pointer; }
	button:focus-visible, a:focus-visible { outline: 3px solid var(--foreground); outline-offset: 3px; }
	[hidden] { display: none !important; }
	.booth-page { min-height: 100dvh; display: grid; place-items: center; padding: clamp(.75rem, 2vw, 1.5rem); }
	.booth-kiosk { position: relative; display: grid; grid-template-columns: clamp(68px, 8vw, 92px) minmax(0, 1fr); width: min(1120px, 100%); height: min(820px, calc(100dvh - 3rem)); min-height: 650px; overflow: hidden; border: 8px solid var(--card); border-radius: 24px; background: var(--card); box-shadow: 0 28px 70px oklch(0 0 0 / 45%); }
	.festival-rail { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem .5rem 1.5rem; color: var(--primary-foreground); background: linear-gradient(180deg, var(--pink), var(--primary) 48%, var(--pink)); }
	.rail-mark { width: 48px; height: 48px; flex: none; display: grid; place-items: center; padding: 0; border: 2px solid currentColor; border-radius: 50%; background: transparent; color: inherit; font: 1rem var(--font-display); }
	.rail-mark :global(img) { display: block; width: 38px; height: auto; max-height: 26px; object-fit: contain; }
	.rail-title { display: flex; flex: 1; align-items: center; justify-content: center; gap: 1.25rem; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; }
	.rail-title h1 { margin: 0; font: 400 clamp(1.05rem, 2.1vw, 1.55rem)/1 var(--font-display); }
	.rail-title span { width: 1px; height: 70px; background: currentColor; opacity: .45; }
	.rail-title p { font-size: .75rem; font-weight: 600; }
	.rail-flower { font-size: 2rem; }
	.booth-stage { position: relative; min-width: 0; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; overflow: hidden; background: var(--background); }
	.stage-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; min-height: 105px; padding: 1rem clamp(1rem, 3vw, 2rem); border-bottom: 1px solid var(--border); }
	.stage-kicker { margin: 0; color: var(--primary); font-size: .72rem; font-weight: 700; text-transform: uppercase; }
	.stage-header h2 { margin: .2rem 0 0; font: 400 clamp(1.5rem, 3.2vw, 2.65rem)/1.05 var(--font-display); text-transform: uppercase; }
	.progress-steps { display: flex; align-items: flex-start; gap: clamp(.6rem, 2vw, 1.5rem); margin: 0; padding: 0; list-style: none; }
	.progress-steps li { display: grid; justify-items: center; gap: .25rem; color: var(--muted-foreground); }
	.progress-steps span { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 50%; font-weight: 700; }
	.progress-steps small { font-size: .68rem; }
	.progress-steps li.active { color: var(--primary); }
	.progress-steps li.active span { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }
	.booth-window { position: relative; min-height: 0; overflow: hidden; background: var(--card); }
	.capture-state { height: 100%; min-height: 450px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: clamp(1.5rem, 5vw, 4rem); text-align: center; background-image: radial-gradient(circle at top right, var(--primary) 0 3px, transparent 4px), radial-gradient(circle at bottom left, var(--pink) 0 3px, transparent 4px); background-size: 32px 32px; }
	.portrait-guide { position: relative; width: clamp(280px, 38vw, 360px); aspect-ratio: 1; display: grid; place-items: center; color: var(--primary); font-size: 1.25rem; }
	.portrait-guide::before,.portrait-guide::after { position: absolute; content: ''; border-radius: 50%; pointer-events: none; }
	.portrait-guide::before { inset: 0; border: 4px solid var(--pink); }
	.portrait-guide::after { inset: 22px; border: 5px solid var(--primary); }
	.portrait-guide > span:first-child,.portrait-guide > span:last-child { position: absolute; z-index: 1; top: 50%; transform: translateY(-50%); color: var(--primary); font-size: 2rem; }
	.portrait-guide > span:first-child { left: -13px; }
	.portrait-guide > span:last-child { right: -13px; }
	.portrait-guide .portrait-rings { display: none; }
	.portrait-guide img { position: relative; z-index: 1; display: block; width: clamp(140px, 14vw, 156px); height: auto; object-fit: contain; filter: drop-shadow(0 8px 10px oklch(0 0 0 / 25%)); }
	.capture-title { margin: 1.8rem 0 0; font: 400 clamp(1.4rem, 3vw, 2.35rem)/1.1 var(--font-display); text-transform: uppercase; }
	.capture-copy { max-width: 31rem; margin: .65rem 0 0; color: var(--muted-foreground); font-size: 1rem; }
	.capture-actions { display: flex; justify-content: center; gap: .75rem; margin-top: 1.5rem; }
	.button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: .65rem; padding: .75rem 1.15rem; border: 1px solid transparent; border-radius: 6px; font-size: .95rem; font-weight: 700; text-decoration: none; transition: transform .16s ease, background-color .16s ease, border-color .16s ease; }
	.button:hover { transform: translateY(-2px); }
	.button svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
	.button-primary { background: var(--primary); color: var(--primary-foreground); }
	.button-primary:hover { background: oklch(.81 .145 79.79); }
	.button-outline { border-color: var(--border); background: var(--background); color: var(--foreground); }
	.button-outline:hover { border-color: var(--primary); }
	.capture-actions .button { min-width: 190px; min-height: 56px; }
	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	.camera-state { position: absolute; inset: 0; background: var(--background); }
	.camera-state video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
	.face-guide { position: absolute; left: 50%; top: 46%; width: min(44%, 360px); height: 68%; transform: translate(-50%, -50%); border: 2px dashed var(--primary); border-radius: 50%; box-shadow: 0 0 0 999px oklch(.12 .02 50 / 18%); pointer-events: none; }
	.shutter { position: absolute; bottom: 24px; left: 50%; display: grid; place-items: center; width: 78px; height: 78px; transform: translateX(-50%); border: 7px solid var(--foreground); border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 4px var(--pink); }
	.shutter span { width: 42px; height: 42px; border: 2px solid var(--primary-foreground); border-radius: 50%; }
	.camera-close { position: absolute; top: 1rem; right: 1rem; width: 42px; height: 42px; border: 1px solid var(--foreground); border-radius: 50%; background: var(--background); color: var(--foreground); font-size: 1.6rem; }
	.photo-state { height: 100%; min-height: 450px; display: grid; grid-template-columns: minmax(220px, .85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(1.5rem, 5vw, 4rem); padding: clamp(1.5rem, 6vw, 5rem); }
	.photo-preview-frame { height: min(470px, 58vh); min-height: 240px; overflow: hidden; border: 3px solid var(--primary); background: var(--muted); }
	.photo-preview-frame img { width: 100%; height: 100%; object-fit: contain; }
	.photo-copy h3,.style-controls h3,.result-toolbar h3 { margin: .4rem 0; font: 400 clamp(1.5rem, 3vw, 2.2rem)/1.08 var(--font-display); }
	.photo-copy > p:not(.stage-kicker) { max-width: 30rem; color: var(--muted-foreground); }
	.photo-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.5rem; }
